---
import { siteConfig } from '../config/site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.authorName} | ${siteConfig.roleTitle}`,
  description = siteConfig.headline,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- MANDATORY: Declare support for both light and dark themes to prevent FOUC -->
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Mermaid Client Rendering — Technical Ink on Warm Paper -->
    <script>
      import mermaid from 'mermaid';
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'neutral',
        themeVariables: {
          darkMode: false,
          background: '#fcfbf9',
          primaryColor: '#ffffff',
          primaryTextColor: '#1c1917',
          primaryBorderColor: '#292524',
          lineColor: '#44403c',
          secondaryColor: '#f7f6f2',
          tertiaryColor: '#eeece6'
        }
      });

      async function renderMermaidDiagrams() {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"], pre:has(> code.language-mermaid)');
        if (!blocks.length) return;

        for (const block of blocks) {
          const rawCode = block.textContent?.trim() || '';
          if (!rawCode) continue;
          const container = document.createElement('div');
          container.className = 'mermaid';
          container.textContent = rawCode;
          block.replaceWith(container);
        }

        try {
          await mermaid.run({
            querySelector: '.mermaid',
          });
        } catch (err) {
          console.error('Mermaid render error:', err);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
      } else {
        renderMermaidDiagrams();
      }
      document.addEventListener('astro:page-load', renderMermaidDiagrams);
    </script>
  </head>
  <body class="bg-[#f7f6f2] text-stone-900 min-h-screen flex flex-col antialiased selection:bg-[#d9481b] selection:text-white">
    <!-- Sticky Architectural Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#f7f6f2]/90 border-b border-[#d6d3c9] transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Brand / Monogram -->
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-md bg-[#18181b] text-white flex items-center justify-center font-mono font-bold text-xs tracking-wider shadow-sm group-hover:bg-[#d9481b] transition-colors">
            NM
          </div>
          <div>
            <span class="font-bold text-stone-900 tracking-tight block leading-tight text-sm">{siteConfig.authorName}</span>
            <span class="text-[10px] text-stone-500 font-mono uppercase tracking-widest block">{siteConfig.roleTitle}</span>
          </div>
        </a>

        <!-- Navigation Links -->
        <nav class="hidden md:flex items-center gap-8 text-xs font-semibold uppercase tracking-wider text-stone-600">
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/#architecture`} class="hover:text-stone-950 transition-colors">Featured Projects</a>
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/#cross-platform`} class="hover:text-[#d9481b] transition-colors">Technical Explorations</a>
        </nav>

        <!-- Actions -->
        <div class="flex items-center gap-3">
          <a
            href={siteConfig.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-1.5 text-xs font-semibold rounded-md border border-[#d6d3c9] bg-white hover:bg-stone-50 text-stone-700 hover:text-stone-950 transition-all flex items-center gap-1.5 shadow-xs"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub</span>
          </a>
          <a
            href={`mailto:${siteConfig.email}`}
            class="px-3.5 py-1.5 text-xs font-semibold rounded-md bg-[#18181b] hover:bg-[#d9481b] text-white shadow-xs transition-colors"
          >
            Contact
          </a>
        </div>
      </div>
    </header>

    <!-- Main Viewport -->
    <main class="flex-1">
      <slot />
    </main>
  </body>
</html>
