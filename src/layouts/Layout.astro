---
import { siteConfig } from '../config/site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.authorName} | ${siteConfig.roleTitle}`,
  description = siteConfig.headline,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- MANDATORY: Declare support for both light and dark themes to prevent FOUC -->
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Mermaid CDN / Client Rendering -->
    <script is:inline type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
      mermaid.initialize({
        startOnLoad: true,
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          background: '#0b0f17',
          primaryColor: '#1f2937',
          primaryTextColor: '#f3f4f6',
          primaryBorderColor: '#6366f1',
          lineColor: '#6366f1',
          secondaryColor: '#111827',
          tertiaryColor: '#0f172a'
        }
      });
    </script>
  </head>
  <body class="bg-[#0b0f17] text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white antialiased">
    <!-- Sticky Glass Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0b0f17]/80 border-b border-white/10 transition-all duration-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo / Brand -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-indigo-600 to-cyan-500 flex items-center justify-center font-bold text-white shadow-md shadow-indigo-500/20 group-hover:scale-105 transition-transform">
            GM
          </div>
          <div>
            <span class="font-bold text-slate-100 tracking-tight group-hover:text-indigo-400 transition-colors block leading-tight">{siteConfig.authorName}</span>
            <span class="text-[11px] text-slate-400 font-mono tracking-wider uppercase block">Systems Architect</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
          <a href="/#architecture" class="hover:text-indigo-400 transition-colors">Architectural Deep Dives</a>
          <a href="/#cross-platform" class="hover:text-cyan-400 transition-colors">AI & Cross-Platform</a>
          <a href="/#philosophy" class="hover:text-indigo-400 transition-colors">Philosophy</a>
          <a href="/#stack" class="hover:text-indigo-400 transition-colors">Tech Matrix</a>
        </nav>

        <!-- Action Buttons -->
        <div class="flex items-center gap-3">
          <a
            href={siteConfig.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-white/10 bg-white/5 hover:bg-white/10 text-slate-200 hover:text-white transition-all flex items-center gap-1.5"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub</span>
          </a>
          <a
            href={`mailto:${siteConfig.email}`}
            class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white shadow-sm shadow-indigo-600/30 transition-all"
          >
            Contact
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-white/10 bg-[#070a10] py-12 text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <p class="font-semibold text-slate-200">{siteConfig.authorName} — {siteConfig.roleTitle}</p>
          <p class="text-xs text-slate-500 mt-1">Specialized in Systems Architecture & AI-Augmented Cross-Platform Engineering.</p>
        </div>
        <div class="flex items-center gap-6 text-xs">
          <a href={siteConfig.githubUrl} target="_blank" class="hover:text-indigo-400 transition-colors">GitHub</a>
          <a href={siteConfig.linkedinUrl} target="_blank" class="hover:text-indigo-400 transition-colors">LinkedIn</a>
          <a href={`mailto:${siteConfig.email}`} class="hover:text-indigo-400 transition-colors">Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
