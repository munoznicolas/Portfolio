---
import Layout from './Layout.astro';
import { siteConfig } from '../config/site.config';

interface Props {
  title: string;
  repoName: string;
  tagline: string;
  pillar: 'architecture' | 'ai-multiplatform';
  category: string;
  techStack: string[];
  metrics?: { label: string; value: string }[];
  githubUrl?: string;
  demoUrl?: string;
  aiMultiplierStory?: string;
}

const {
  title,
  repoName,
  tagline,
  pillar,
  category,
  techStack,
  metrics = [],
  githubUrl,
  demoUrl,
  aiMultiplierStory,
} = Astro.props;
---

<Layout title={`${title} | Case Study — ${siteConfig.authorName}`} description={tagline}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <!-- Breadcrumb & Back Link -->
    <div class="mb-10 flex items-center text-xs text-stone-500 font-mono">
      <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 hover:text-stone-900 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>INDEX</span>
      </a>
    </div>

    <!-- Case Study Header Banner -->
    <header class="mb-14 pb-12 border-b border-[#d6d3c9]">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class={`px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider rounded border ${
          pillar === 'architecture'
            ? 'bg-blue-50 text-blue-800 border-blue-200'
            : 'bg-orange-50 text-[#d9481b] border-orange-200'
        }`}>
          {pillar === 'architecture' ? 'Featured Project' : 'Technical Exploration'}
        </span>
        <span class="px-2.5 py-1 text-[11px] font-mono rounded bg-[#eeece6] text-stone-600 border border-[#d6d3c9]">
          {category}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-stone-900 tracking-tight leading-tight mb-4">
        {title}
      </h1>
      <p class="text-base sm:text-lg text-stone-600 leading-relaxed max-w-2xl mb-8">
        {tagline}
      </p>

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap items-center gap-1.5 mb-8">
        {techStack.map((tech) => (
          <span class="px-2 py-0.5 text-xs font-mono rounded bg-white text-stone-700 border border-[#d6d3c9] shadow-2xs">
            {tech}
          </span>
        ))}
      </div>

      <!-- Metrics Highlight Bar -->
      {metrics && metrics.length > 0 && (
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-lg bg-[#eeece6] border border-[#d6d3c9] mb-8">
          {metrics.map((m) => (
            <div>
              <div class="text-[10px] uppercase tracking-wider text-stone-500 font-mono mb-0.5">{m.label}</div>
              <div class="text-lg sm:text-xl font-bold text-stone-900 tracking-tight font-mono">{m.value}</div>
            </div>
          ))}
        </div>
      )}

      <!-- Links & CTAs -->
      <div class="flex flex-wrap items-center gap-3">
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-md bg-white hover:bg-stone-50 border border-[#d6d3c9] text-stone-800 text-xs font-semibold flex items-center gap-2 transition-all shadow-xs"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>Source Code</span>
          </a>
        )}
        {demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-md bg-[#18181b] hover:bg-[#d9481b] text-white text-xs font-semibold flex items-center gap-1.5 transition-colors shadow-xs"
          >
            <span>Live Demonstration</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>

      <!-- AI Multiplier Callout Banner -->
      {aiMultiplierStory && (
        <div class="mt-8 p-4 rounded-lg border border-orange-200 bg-orange-50/50">
          <div class="flex items-center gap-2 text-[#d9481b] text-xs font-mono font-bold tracking-wider uppercase mb-1.5">
            <span class="w-2 h-2 rounded-full bg-[#d9481b]"></span>
            The AI Force-Multiplier Impact
          </div>
          <p class="text-xs text-stone-700 leading-relaxed">
            {aiMultiplierStory}
          </p>
        </div>
      )}
    </header>

    <!-- Case Study Body Prose -->
    <article class="prose prose-stone max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-stone-900 prose-a:text-[#d9481b] hover:prose-a:underline prose-pre:bg-[#18181b] prose-pre:text-stone-100 prose-pre:border prose-pre:border-stone-800">
      <slot />
    </article>

    <!-- Bottom Navigation Footer -->
    <div class="mt-16 pt-8 border-t border-[#d6d3c9] flex items-center justify-between text-xs font-mono">
      <a href={import.meta.env.BASE_URL} class="text-stone-600 hover:text-stone-950 flex items-center gap-1.5 transition-colors">
        ← BACK TO OVERVIEW
      </a>
      <a href="#top" class="text-stone-500 hover:text-stone-950 transition-colors">
        TOP ↑
      </a>
    </div>
  </div>
</Layout>
