---
interface Props {
  title?: string;
  class?: string;
}

const { title = "Application Window", class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-white/10 bg-[#111827] overflow-hidden shadow-2xl ${className}`}>
  <!-- Window Header -->
  <div class="flex items-center justify-between px-4 py-2.5 bg-[#0f172a] border-b border-white/5 select-none">
    <div class="flex items-center gap-2">
      <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
      <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
      <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
    </div>
    <span class="text-xs font-medium text-slate-400 truncate max-w-[200px] sm:max-w-md">{title}</span>
    <div class="w-12 flex justify-end text-xs text-slate-600">-- □ ✕</div>
  </div>
  <!-- Window Body -->
  <div class="p-4 sm:p-6 bg-[#0b0f17]/90 text-slate-200">
    <slot />
  </div>
</div>
