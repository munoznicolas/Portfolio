---
interface Props {
  title?: string;
  class?: string;
}

const { title = "Application Window", class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-[#d6d3c9] bg-[#eeece6] overflow-hidden shadow-sm ${className}`}>
  <!-- Warm Matte Window Header -->
  <div class="flex items-center justify-between px-4 py-2.5 bg-[#e4e1d8] border-b border-[#d6d3c9] select-none">
    <div class="flex items-center gap-2">
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
    </div>
    <span class="text-xs font-mono font-medium text-stone-700 truncate max-w-[200px] sm:max-w-md">{title}</span>
    <div class="w-12 flex justify-end text-[10px] text-stone-500 font-mono tracking-widest">-- □ ✕</div>
  </div>

  <!-- High-Contrast Native Viewport Inside -->
  <div class="p-4 sm:p-6 bg-[#111827] text-slate-100">
    <slot />
  </div>
</div>
