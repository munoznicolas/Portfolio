---
interface Props {
  command?: string;
  class?: string;
}

const { command = "ts2mermaid --help", class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-[#d6d3c9] bg-[#eeece6] overflow-hidden shadow-sm font-mono ${className}`}>
  <!-- Terminal Title Bar -->
  <div class="flex items-center justify-between px-4 py-2 bg-[#e4e1d8] border-b border-[#d6d3c9] select-none text-xs">
    <div class="flex items-center gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
    </div>
    <span class="text-stone-600 text-[11px] truncate">{command}</span>
    <span class="text-[9px] text-stone-500 uppercase tracking-wider">SHELL</span>
  </div>

  <!-- Terminal Body -->
  <div class="p-4 sm:p-5 text-xs text-emerald-400 bg-[#0d1117] overflow-x-auto leading-relaxed">
    <slot />
  </div>
</div>
