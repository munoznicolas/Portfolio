---
interface Props {
  command?: string;
  class?: string;
}

const { command = "ts2mermaid --help", class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-white/10 bg-[#0d1117] overflow-hidden shadow-2xl font-mono ${className}`}>
  <!-- Terminal Title Bar -->
  <div class="flex items-center justify-between px-4 py-2 bg-[#161b22] border-b border-white/5 select-none text-xs">
    <div class="flex items-center gap-2">
      <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
      <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
      <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
    </div>
    <span class="text-slate-400 font-sans text-[11px] truncate">{command}</span>
    <span class="text-[10px] text-slate-500">bash</span>
  </div>

  <!-- Terminal Body -->
  <div class="p-4 sm:p-5 text-sm text-emerald-400 bg-[#0d1117] overflow-x-auto leading-relaxed">
    <slot />
  </div>
</div>
