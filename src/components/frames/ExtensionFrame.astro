---
interface Props {
  name?: string;
  class?: string;
}

const { name = "Chrome Extension", class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-[#d6d3c9] bg-[#eeece6] overflow-hidden shadow-sm ${className}`}>
  <!-- Chrome Extension Toolbar Header -->
  <div class="flex items-center justify-between px-4 py-2 bg-[#e4e1d8] border-b border-[#d6d3c9] select-none text-xs text-stone-700">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[#d9481b]"></span>
      <span class="font-bold tracking-tight text-[11px]">{name}</span>
      <span class="px-1.5 py-0.2 rounded bg-white text-stone-600 border border-[#d6d3c9] text-[9px] font-mono">MV3</span>
    </div>
    <div class="text-[10px] text-stone-500 font-mono">EXT://LOCAL</div>
  </div>

  <!-- Extension Popup Container -->
  <div class="p-4 sm:p-5 bg-[#111827] text-slate-100">
    <slot />
  </div>
</div>
