---
interface Props {
  url?: string;
  class?: string;
}

const { url = "https://app.local", class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-[#d6d3c9] bg-[#eeece6] overflow-hidden shadow-sm ${className}`}>
  <!-- Warm Matte Bezel Header -->
  <div class="flex items-center gap-3 px-4 py-2.5 bg-[#e4e1d8] border-b border-[#d6d3c9] select-none">
    <div class="flex items-center gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#c5c1b6] border border-[#a8a29e]/40"></div>
    </div>
    
    <!-- URL Bar -->
    <div class="flex-1 max-w-sm mx-auto flex items-center gap-2 px-3 py-1 bg-white border border-[#d6d3c9] rounded text-[11px] font-mono text-stone-600 shadow-2xs">
      <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
      <span class="truncate">{url}</span>
    </div>
  </div>

  <!-- High-Contrast Native Viewport Inside -->
  <div class="p-4 sm:p-6 bg-[#111827] text-slate-100">
    <slot />
  </div>
</div>
