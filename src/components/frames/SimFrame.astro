---
interface Props {
  title?: string;
  class?: string;
}

const { title = "CSP Lua Telemetry Runtime", class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-[#d6d3c9] bg-[#eeece6] overflow-hidden shadow-sm relative ${className}`}>
  <!-- Telemetry HUD Header -->
  <div class="flex items-center justify-between px-4 py-2.5 bg-[#e4e1d8] border-b border-[#d6d3c9] select-none">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 rounded-full bg-[#d9481b] animate-ping"></div>
      <span class="text-xs font-mono font-bold tracking-wider text-stone-800 uppercase">{title}</span>
    </div>
    <div class="flex items-center gap-3 text-[10px] font-mono text-stone-500">
      <span>SECTOR: 1</span>
      <span class="text-stone-800 font-bold">FPS: 90</span>
      <span class="text-[#d9481b] font-bold">CSP v0.2.3</span>
    </div>
  </div>

  <!-- Racing Cockpit / HUD Body -->
  <div class="p-4 sm:p-6 bg-[#0e1118] text-slate-100">
    <slot />
  </div>
</div>
