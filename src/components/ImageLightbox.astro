---
/**
 * ImageLightbox.astro
 * Minimalist expanded view for project pictures and placeholders.
 * Clean: Displays only the enlarged image/placeholder with no title or exit footnotes.
 */
---

<dialog
  id="project-image-lightbox"
  closedby="any"
  class="backdrop:bg-stone-950/80 backdrop:backdrop-blur-sm bg-transparent p-0 max-w-5xl w-[92vw] max-h-[90vh] rounded-3xl outline-none border-0 shadow-none m-auto cursor-zoom-out overflow-hidden"
  aria-label="Enlarged Project Preview"
>
  <div class="relative w-full h-full flex items-center justify-center cursor-zoom-out overflow-hidden">
    <!-- Floating Close Button inside bounds -->
    <button
      type="button"
      id="lightbox-close-btn"
      class="absolute top-4 right-4 z-20 w-8 h-8 rounded-full bg-stone-900/80 hover:bg-stone-900 text-white flex items-center justify-center transition-colors text-sm font-mono font-bold shadow-lg border border-white/20 focus:outline-none"
      aria-label="Close enlarged preview"
    >
      ✕
    </button>

    <!-- Enlarged Content Container (Only the picture / placeholder) -->
    <div id="lightbox-content" class="w-full flex items-center justify-center cursor-zoom-out overflow-hidden">
      <!-- Populated dynamically via client script -->
    </div>
  </div>
</dialog>

<style>
  dialog#project-image-lightbox {
    overflow: hidden !important;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }
  dialog#project-image-lightbox::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
</style>

<script>
  function setupLightbox() {
    const dialog = document.getElementById('project-image-lightbox') as HTMLDialogElement | null;
    const lightboxContent = document.getElementById('lightbox-content');
    const closeBtn = document.getElementById('lightbox-close-btn');
    if (!dialog || !lightboxContent) return;

    // Clicking anywhere on the dialog, backdrop, or enlarged picture dismisses it
    dialog.addEventListener('click', () => {
      dialog.close();
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      dialog.close();
    });

    // Attach listeners to all image/placeholder triggers
    const triggers = document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]');
    triggers.forEach((trigger) => {
      const newTrigger = trigger.cloneNode(true) as HTMLElement;
      trigger.parentNode?.replaceChild(newTrigger, trigger);

      newTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        const title = newTrigger.dataset.title || 'Project Preview';
        const imgSrc = newTrigger.dataset.imgSrc || '';
        const imgAlt = newTrigger.dataset.imgAlt || title;

        if (imgSrc) {
          lightboxContent.innerHTML = `
            <div class="aspect-[16/10] w-full max-h-[85vh] rounded-2xl sm:rounded-3xl overflow-hidden border border-[#d6d3c9] bg-stone-900 flex items-center justify-center shadow-2xl">
              <img src="${imgSrc}" alt="${imgAlt}" class="w-full h-full object-contain" />
            </div>
          `;
        } else {
          lightboxContent.innerHTML = `
            <div class="aspect-[16/10] w-full max-h-[85vh] rounded-2xl sm:rounded-3xl border-2 sm:border-3 border-stone-900 bg-[#fcfbf9] flex flex-col items-center justify-center p-8 sm:p-14 text-center shadow-2xl">
              <svg class="w-16 h-16 sm:w-20 sm:h-20 text-stone-400 mb-4 stroke-[1.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
              </svg>
              <span class="text-base sm:text-xl font-medium text-stone-800">
                Placeholder image to be replaced
              </span>
            </div>
          `;
        }

        dialog.showModal();
      });
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
