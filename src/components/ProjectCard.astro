---
import type { ProjectCardConfig } from '../config/projects.config';

export type Props = ProjectCardConfig;

const { title, image, description, techStack, caseStudyUrl } = Astro.props;

const withBase = (path?: string) => {
  if (!path) return '';
  if (path.startsWith('http://') || path.startsWith('https://') || path.startsWith('#')) return path;
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return `${base}${cleanPath}`;
};

const pillStyles = [
  'border-orange-500 text-orange-700 bg-orange-50/50',
  'border-rose-900 text-rose-900 bg-rose-50/40',
  'border-emerald-700 text-emerald-800 bg-emerald-50/50',
  'border-indigo-600 text-indigo-800 bg-indigo-50/50',
  'border-amber-700 text-amber-900 bg-amber-50/50',
  'border-teal-700 text-teal-800 bg-teal-50/50',
];
---

<div class="rounded-2xl border border-[#d6d3c9] bg-white p-6 sm:p-7 flex flex-col justify-between hover:border-stone-500 transition-all duration-200 group shadow-xs">
  <div>
    <!-- Card Title with Project Name -->
    <h3 class="text-2xl font-bold text-stone-900 group-hover:text-[#d9481b] transition-colors mb-4">
      {title}
    </h3>

    <!-- Placeholder Image / Configured Project Image -->
    <button
      type="button"
      class="w-full text-left p-0 border-0 bg-transparent cursor-zoom-in group/img block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#d9481b] rounded-2xl mb-5"
      data-lightbox-trigger
      data-title={title}
      data-img-src={withBase(image?.src)}
      data-img-alt={image?.alt || title}
      aria-label={`Enlarge image for ${title}`}
    >
      {image?.src ? (
        <div class="aspect-[16/10] w-full rounded-2xl overflow-hidden border border-[#d6d3c9] bg-[#eeece6] relative shadow-2xs">
          <img
            src={withBase(image.src)}
            alt={image.alt || title}
            class="w-full h-full object-cover group-hover/img:scale-[1.02] transition-transform duration-300"
            loading="lazy"
          />
          <div class="absolute bottom-2.5 right-2.5 px-2.5 py-1 bg-stone-900/80 backdrop-blur-xs text-white text-[11px] font-mono rounded-md opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center gap-1.5 shadow-sm">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
            </svg>
            <span>Enlarge</span>
          </div>
        </div>
      ) : (
        <div class="aspect-[16/10] w-full rounded-2xl border-2 border-stone-900 bg-[#fcfbf9] flex flex-col items-center justify-center p-5 text-center relative group-hover/img:border-[#d9481b] group-hover/img:bg-stone-50 transition-all">
          <svg class="w-7 h-7 text-stone-400 mb-2 stroke-[1.5] group-hover/img:text-[#d9481b] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
          </svg>
          <span class="text-sm font-medium text-stone-700 group-hover/img:text-stone-900 transition-colors">
            Placeholder image to be replaced
          </span>
          <div class="absolute bottom-2.5 right-2.5 px-2.5 py-1 bg-stone-900/80 backdrop-blur-xs text-white text-[11px] font-mono rounded-md opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center gap-1.5 shadow-sm">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
            </svg>
            <span>Enlarge</span>
          </div>
        </div>
      )}
    </button>

    <!-- Problem-Solution Description (8-12 lines) -->
    <p class="text-stone-700 text-sm leading-relaxed mb-6 font-normal whitespace-pre-line">
      {description}
    </p>

    <!-- Technology Pills -->
    <div class="flex flex-wrap gap-2 mb-6">
      {techStack.map((tech, idx) => (
        <span class={`px-3 py-1 text-xs font-mono font-medium rounded-full border-2 ${pillStyles[idx % pillStyles.length]}`}>
          {tech}
        </span>
      ))}
    </div>
  </div>

  <!-- Divider & Case Study Link -->
  <div class="pt-4 border-t border-[#eeece6] flex items-center justify-between mt-auto">
    {caseStudyUrl ? (
      <a
        href={withBase(caseStudyUrl)}
        class="text-xs font-mono font-bold uppercase tracking-wider text-stone-800 group-hover:text-[#d9481b] transition-colors flex items-center gap-1.5"
      >
        <span>Case Study</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    ) : (
      <span class="text-xs font-mono uppercase tracking-wider text-stone-400">Case Study Coming Soon</span>
    )}
  </div>
</div>
