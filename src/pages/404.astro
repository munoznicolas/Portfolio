---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <div class="w-16 h-16 rounded-lg bg-[#eeece6] border border-[#d6d3c9] text-stone-900 flex items-center justify-center font-mono font-bold text-2xl mb-6 shadow-xs">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-3">
      Page Not Found
    </h1>
    <p class="text-stone-600 max-w-md mb-8 text-sm leading-relaxed">
      The requested route or project blueprint does not exist in this catalog.
    </p>
    <a
      href={import.meta.env.BASE_URL}
      class="px-5 py-2.5 rounded-md bg-[#18181b] hover:bg-[#d9481b] text-white font-semibold text-xs uppercase tracking-wider font-mono transition-colors shadow-xs"
    >
      Return to Index
    </a>
  </div>
</Layout>
