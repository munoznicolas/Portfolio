---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
    <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-mono font-bold text-2xl mb-6 shadow-lg shadow-indigo-500/10">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">
      Page Not Found
    </h1>
    <p class="text-slate-400 max-w-md mb-8 text-sm leading-relaxed">
      The requested route or project blueprint does not exist in this portfolio.
    </p>
    <a
      href="/"
      class="px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all shadow-md shadow-indigo-600/30"
    >
      Return to Home Overview
    </a>
  </div>
</Layout>
