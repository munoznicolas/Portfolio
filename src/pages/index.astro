---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.config';

const allProjects = await getCollection('projects');
const architectureProjects = allProjects
  .filter((p) => p.data.pillar === 'architecture')
  .sort((a, b) => a.data.order - b.data.order);

const crossPlatformProjects = allProjects
  .filter((p) => p.data.pillar === 'ai-multiplatform')
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-20 sm:py-28 border-b border-white/10 bg-radial from-indigo-950/20 via-[#0b0f17] to-[#0b0f17]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-300 text-xs font-mono font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Architectural System Design & AI-Augmented Engineering</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.1] mb-6">
          Architecting resilient systems. <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-cyan-400 to-emerald-400">
            Accelerated by autonomous AI.
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-8">
          Senior Fullstack & Systems Architect delivering scalable distributed backends and browser-edge AI — while directing AI agentic workflows to master niche game runtimes, native OS desktop frameworks, and compiler toolchains.
        </p>

        <!-- Metric Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
          <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/10">
            <div class="text-xl sm:text-2xl font-bold text-white font-mono">7+</div>
            <div class="text-xs text-slate-400 mt-0.5">Polyglot Stacks</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/10">
            <div class="text-xl sm:text-2xl font-bold text-indigo-400 font-mono">Zero-GC</div>
            <div class="text-xs text-slate-400 mt-0.5">WASM Tensor Pools</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/10">
            <div class="text-xl sm:text-2xl font-bold text-cyan-400 font-mono">SRID 4326</div>
            <div class="text-xs text-slate-400 mt-0.5">PostGIS Spatial Queries</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/10">
            <div class="text-xl sm:text-2xl font-bold text-emerald-400 font-mono">.NET 10</div>
            <div class="text-xs text-slate-400 mt-0.5">Native Windows Fluent</div>
          </div>
        </div>

        <!-- Hero CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#architecture"
            class="px-6 py-3 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all shadow-lg shadow-indigo-600/30 flex items-center gap-2"
          >
            <span>Architectural Deep Dives</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="#cross-platform"
            class="px-6 py-3 rounded-lg bg-slate-800/80 hover:bg-slate-700/80 border border-white/10 text-slate-200 font-semibold text-sm transition-all flex items-center gap-2"
          >
            <span>AI Multi-Platform Showcase</span>
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pillar I: Architectural Deep Dives -->
  <section id="architecture" class="py-20 sm:py-28 border-b border-white/10 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-2xl mb-16">
        <div class="text-xs font-mono font-bold tracking-widest text-indigo-400 uppercase mb-2">Pillar I</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          Architectural Deep Dives
        </h2>
        <p class="text-slate-400 text-base leading-relaxed">
          Showcasing clean system design, scalable state management, and distributed boundaries across edge computing and real-time backend ecosystems.
        </p>
      </div>

      <!-- Architecture Showcase Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {architectureProjects.map((project) => (
          <div class="rounded-2xl border border-white/10 bg-[#111827]/80 backdrop-blur p-6 sm:p-8 flex flex-col justify-between hover:border-indigo-500/40 transition-all duration-300 group shadow-xl">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-4">
                <span class="px-2.5 py-1 rounded bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 font-semibold">
                  {project.data.category}
                </span>
                <span class="text-slate-500">repo: {project.data.repoName}</span>
              </div>

              <h3 class="text-2xl font-bold text-white group-hover:text-indigo-300 transition-colors mb-3">
                {project.data.title}
              </h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                {project.data.tagline}
              </p>

              <!-- Architecture Highlights Checklist -->
              {project.data.architectureFocus && (
                <div class="mb-6 space-y-2">
                  <div class="text-xs font-mono uppercase tracking-wider text-slate-400">Key Architectural Decisions:</div>
                  <ul class="text-xs text-slate-300 space-y-1.5 pl-4 list-disc marker:text-indigo-400">
                    {project.data.architectureFocus.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Tech Stack Badges -->
              <div class="flex flex-wrap gap-1.5 mb-8">
                {project.data.techStack.map((tech) => (
                  <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-[#1e293b] text-slate-300 border border-white/5">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Bottom CTA -->
            <div class="pt-4 border-t border-white/5 flex items-center justify-between">
              <a
                href={`/projects/${project.id}`}
                class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-400 group-hover:text-indigo-300 transition-colors"
              >
                <span>Read Full Architectural Case Study</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pillar II: AI-Augmented Cross-Platform Engineering -->
  <section id="cross-platform" class="py-20 sm:py-28 border-b border-white/10 bg-[#070a10]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-2xl mb-16">
        <div class="text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase mb-2">Pillar II</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          AI-Augmented Cross-Platform Engineering
        </h2>
        <p class="text-slate-400 text-base leading-relaxed">
          Demonstrating how senior architectural guidance enables autonomous AI agents to rapidly enter and ship across diverse platforms: automotive game engine modding, native Windows .NET desktop, Chrome extensions, and compiler AST tooling.
        </p>
      </div>

      <!-- 5-Card Responsive Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {crossPlatformProjects.map((project) => (
          <div class="rounded-xl border border-white/10 bg-[#111827]/70 p-6 flex flex-col justify-between hover:border-cyan-500/40 transition-all group shadow-lg">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-3">
                <span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 font-semibold text-[10px] uppercase">
                  {project.data.category}
                </span>
                <span class="text-slate-500 text-[11px] truncate max-w-[120px]">{project.data.repoName}</span>
              </div>

              <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-2">
                {project.data.title}
              </h3>
              <p class="text-slate-300 text-xs leading-relaxed mb-4">
                {project.data.tagline}
              </p>

              <!-- The AI Force Multiplier Pill -->
              {project.data.aiMultiplierStory && (
                <div class="p-3 rounded-lg bg-cyan-950/20 border border-cyan-500/15 text-[11px] text-slate-300 mb-4 line-clamp-3 leading-relaxed">
                  <span class="text-cyan-400 font-bold font-mono uppercase text-[10px] block mb-1">AI Synergies:</span>
                  {project.data.aiMultiplierStory}
                </div>
              )}

              <!-- Tech Stack Badges -->
              <div class="flex flex-wrap gap-1 mb-6">
                {project.data.techStack.slice(0, 4).map((tech) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-[#1e293b] text-slate-400">
                    {tech}
                  </span>
                ))}
                {project.data.techStack.length > 4 && (
                  <span class="px-1.5 py-0.5 text-[10px] font-mono text-slate-500">
                    +{project.data.techStack.length - 4}
                  </span>
                )}
              </div>
            </div>

            <div class="pt-3 border-t border-white/5 flex items-center justify-between">
              <a
                href={`/projects/${project.id}`}
                class="text-xs font-semibold text-cyan-400 group-hover:text-cyan-300 transition-colors flex items-center gap-1"
              >
                <span>View Case Study</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Philosophy & AI Synergy Section -->
  <section id="philosophy" class="py-20 sm:py-28 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16">
        <div class="text-xs font-mono font-bold tracking-widest text-indigo-400 uppercase mb-2">Methodology</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          The Senior Architect & AI Agent Synergy
        </h2>
        <p class="text-slate-400 text-base leading-relaxed">
          AI agents are not autonomous replacements for senior architectural thinking; they are execution amplifiers. High-leverage outcomes happen when an architect establishes formal specifications, type safety, and automated test harnesses for agents to iterate within.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-xl bg-[#111827] border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center font-mono font-bold mb-4">01</div>
          <h3 class="font-bold text-white mb-2">Schema-First Contracts</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Formulating formal JSON schemas, TypeScript interfaces, and REST/WebSocket API contracts before writing implementation logic gives AI agents unambiguous constraints.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-[#111827] border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center font-mono font-bold mb-4">02</div>
          <h3 class="font-bold text-white mb-2">Headless Simulation Harnesses</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Decoupling complex simulation, kinematics, and heuristics from slow UI rendering loops lets agents validate thousands of tests in milliseconds.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-[#111827] border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center font-mono font-bold mb-4">03</div>
          <h3 class="font-bold text-white mb-2">Type Safety & AST Boundaries</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Leveraging strict compilers (TypeScript, C# .NET, Rust) provides immediate deterministic feedback to agents when refactoring cross-platform systems.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-[#111827] border border-white/10">
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center font-mono font-bold mb-4">04</div>
          <h3 class="font-bold text-white mb-2">Parallelized Agent Execution</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Breaking down large systems into Work Breakdown Structures (WBS) enables multiple specialized agents to work in parallel on isolated features.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Skills & Stack Matrix -->
  <section id="stack" class="py-20 sm:py-28 bg-[#070a10]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-16">
        <div class="text-xs font-mono font-bold tracking-widest text-emerald-400 uppercase mb-2">Capabilities</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          Polyglot Technology Matrix
        </h2>
        <p class="text-slate-400 text-base leading-relaxed">
          Technologies and ecosystems actively deployed across the showcased repositories.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-xl bg-[#111827] border border-white/10">
          <h3 class="font-mono text-xs uppercase tracking-wider text-indigo-400 font-bold mb-4">Languages & Runtimes</h3>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">TypeScript</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">C# (.NET 10)</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Python 3</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Lua (CSP SDK)</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">JavaScript / ESNext</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">SQL / PostGIS</span>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-[#111827] border border-white/10">
          <h3 class="font-mono text-xs uppercase tracking-wider text-cyan-400 font-bold mb-4">Frontend & Edge AI</h3>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Angular (18 - 22)</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">ONNX Runtime Web</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">WebAssembly (WASM)</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Web Workers</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Signals & NgRx</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Tailwind CSS</span>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-[#111827] border border-white/10">
          <h3 class="font-mono text-xs uppercase tracking-wider text-emerald-400 font-bold mb-4">Backend & Distributed</h3>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">ASP.NET Core Web API</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Express / Node.js</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">TSyringe IoC / DI</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">PostgreSQL + PostGIS</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Socket.io / WebSockets</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">MongoDB / Mongoose</span>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-[#111827] border border-white/10">
          <h3 class="font-mono text-xs uppercase tracking-wider text-amber-400 font-bold mb-4">Native, Privacy & Tooling</h3>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">WPF / Fluent Mica</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Windows DPAPI</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Chrome MV3</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Oblivious HTTP (OHTTP)</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">TypeScript AST API</span>
            <span class="px-2.5 py-1 rounded bg-[#1e293b] text-slate-200">Mermaid.js</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
