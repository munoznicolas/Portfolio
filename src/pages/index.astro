---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.config';

const allProjects = await getCollection('projects');
const architectureProjects = allProjects
  .filter((p) => p.data.pillar === 'architecture')
  .sort((a, b) => a.data.order - b.data.order);

const crossPlatformProjects = allProjects
  .filter((p) => p.data.pillar === 'ai-multiplatform')
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-24 sm:py-32 border-b border-[#d6d3c9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-6xl font-extrabold text-stone-900 tracking-tight leading-[1.1] mb-8">
          Architecting resilient systems accelerated by autonomous AI.
        </h1>

        <p class="text-lg sm:text-xl text-stone-600 leading-relaxed max-w-2xl font-normal">
          Senior Fullstack & Systems Architect delivering scalable distributed backends and browser-edge vision — while directing AI agents to enter niche game runtimes, native OS desktop frameworks, and compiler toolchains.
        </p>
      </div>
    </div>
  </section>

  <!-- Pillar I: Architectural Deep Dives -->
  <section id="architecture" class="py-20 sm:py-28 border-b border-[#d6d3c9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-2xl mb-16">
        <div class="text-[11px] font-mono font-bold tracking-widest text-[#d9481b] uppercase mb-2">Pillar 01</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
          Architectural Deep Dives
        </h2>
        <p class="text-stone-600 text-sm leading-relaxed">
          Clean system design, scalable state machines, and distributed boundaries across browser-edge AI and real-time backend ecosystems.
        </p>
      </div>

      <!-- Architecture Showcase Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {architectureProjects.map((project) => (
          <div class="rounded-xl border border-[#d6d3c9] bg-white p-7 sm:p-9 flex flex-col justify-between hover:border-stone-500 transition-all duration-200 group shadow-xs">
            <div>
              <h3 class="text-2xl font-bold text-stone-900 group-hover:text-[#d9481b] transition-colors mb-3">
                {project.data.title}
              </h3>
              <p class="text-stone-600 text-sm leading-relaxed mb-6">
                {project.data.tagline}
              </p>

              <!-- Architecture Highlights Checklist -->
              {project.data.architectureFocus && (
                <div class="mb-6 space-y-2">
                  <div class="text-[10px] font-mono uppercase tracking-wider text-stone-400 font-bold">Key Architectural Decisions:</div>
                  <ul class="text-xs text-stone-700 space-y-1.5 pl-4 list-disc marker:text-[#d9481b]">
                    {project.data.architectureFocus.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Tech Stack Badges -->
              <div class="flex flex-wrap gap-1.5 mb-8">
                {project.data.techStack.map((tech) => (
                  <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-[#eeece6] text-stone-700 border border-[#d6d3c9]">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Bottom CTA -->
            <div class="pt-5 border-t border-[#eeece6] flex items-center justify-between">
              <a
                href={`/projects/${project.id}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-900 group-hover:text-[#d9481b] uppercase tracking-wider font-mono transition-colors"
              >
                <span>Read Architectural Case Study</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pillar II: AI-Augmented Cross-Platform Engineering -->
  <section id="cross-platform" class="py-20 sm:py-28 border-b border-[#d6d3c9] bg-[#eeece6]/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-2xl mb-16">
        <div class="text-[11px] font-mono font-bold tracking-widest text-blue-700 uppercase mb-2">Pillar 02</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
          AI-Augmented Cross-Platform Engineering
        </h2>
        <p class="text-stone-600 text-sm leading-relaxed">
          How senior architectural guidance enables autonomous AI agents to rapidly enter and ship across diverse environments: automotive game engine modding, native Windows .NET desktop, Chrome extensions, and compiler AST tooling.
        </p>
      </div>

      <!-- 5-Card Responsive Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {crossPlatformProjects.map((project) => (
          <div class="rounded-xl border border-[#d6d3c9] bg-white p-6 flex flex-col justify-between hover:border-stone-500 transition-all group shadow-xs">
            <div>
              <div class="flex items-center text-xs font-mono text-stone-400 mb-3">
                <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-800 border border-blue-200 font-semibold text-[10px] uppercase">
                  {project.data.category}
                </span>
              </div>

              <h3 class="text-xl font-bold text-stone-900 group-hover:text-blue-700 transition-colors mb-2">
                {project.data.title}
              </h3>
              <p class="text-stone-600 text-xs leading-relaxed mb-4">
                {project.data.tagline}
              </p>

              <!-- The AI Force Multiplier Pill -->
              {project.data.aiMultiplierStory && (
                <div class="p-3 rounded-md bg-[#f7f6f2] border border-[#d6d3c9] text-[11px] text-stone-700 mb-4 line-clamp-3 leading-relaxed">
                  <span class="text-[#d9481b] font-bold font-mono uppercase text-[9px] block mb-1">AI Synergies:</span>
                  {project.data.aiMultiplierStory}
                </div>
              )}

              <!-- Tech Stack Badges -->
              <div class="flex flex-wrap gap-1 mb-6">
                {project.data.techStack.slice(0, 4).map((tech) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono rounded bg-[#eeece6] text-stone-600 border border-[#d6d3c9]">
                    {tech}
                  </span>
                ))}
                {project.data.techStack.length > 4 && (
                  <span class="px-1.5 py-0.5 text-[10px] font-mono text-stone-400">
                    +{project.data.techStack.length - 4}
                  </span>
                )}
              </div>
            </div>

            <div class="pt-3 border-t border-stone-100 flex items-center justify-between">
              <a
                href={`/projects/${project.id}`}
                class="text-xs font-mono font-bold uppercase tracking-wider text-stone-800 group-hover:text-[#d9481b] transition-colors flex items-center gap-1"
              >
                <span>Case Study</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Philosophy & AI Synergy Section -->
  <section id="philosophy" class="py-20 sm:py-28 border-b border-[#d6d3c9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16">
        <div class="text-[11px] font-mono font-bold tracking-widest text-[#d9481b] uppercase mb-2">Methodology</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
          The Senior Architect & AI Agent Synergy
        </h2>
        <p class="text-stone-600 text-sm leading-relaxed">
          AI agents are not autonomous replacements for senior architectural thinking; they are execution amplifiers. High-leverage outcomes happen when an architect establishes formal specifications, type safety, and automated test harnesses for agents to iterate within.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-xl bg-white border border-[#d6d3c9] shadow-xs">
          <div class="w-8 h-8 rounded bg-[#eeece6] border border-[#d6d3c9] text-stone-900 flex items-center justify-center font-mono font-bold text-xs mb-4">01</div>
          <h3 class="font-bold text-stone-900 mb-2 text-sm">Schema-First Contracts</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Formulating formal JSON schemas, TypeScript interfaces, and REST/WebSocket API contracts before writing implementation logic gives AI agents unambiguous boundaries.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-white border border-[#d6d3c9] shadow-xs">
          <div class="w-8 h-8 rounded bg-[#eeece6] border border-[#d6d3c9] text-stone-900 flex items-center justify-center font-mono font-bold text-xs mb-4">02</div>
          <h3 class="font-bold text-stone-900 mb-2 text-sm">Headless Simulation</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Decoupling complex simulation, kinematics, and heuristics from slow UI rendering loops lets agents validate thousands of tests in milliseconds.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-white border border-[#d6d3c9] shadow-xs">
          <div class="w-8 h-8 rounded bg-[#eeece6] border border-[#d6d3c9] text-stone-900 flex items-center justify-center font-mono font-bold text-xs mb-4">03</div>
          <h3 class="font-bold text-stone-900 mb-2 text-sm">Strict Type Boundaries</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Leveraging strict compilers (TypeScript, C# .NET) provides immediate deterministic feedback to agents when refactoring cross-platform systems.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-white border border-[#d6d3c9] shadow-xs">
          <div class="w-8 h-8 rounded bg-[#eeece6] border border-[#d6d3c9] text-stone-900 flex items-center justify-center font-mono font-bold text-xs mb-4">04</div>
          <h3 class="font-bold text-stone-900 mb-2 text-sm">Parallelized Execution</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Breaking down large systems into Work Breakdown Structures (WBS) enables multiple specialized agents to work in parallel on isolated features.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Skills & Stack Matrix -->
  <section id="stack" class="py-20 sm:py-28 bg-[#eeece6]/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-16">
        <div class="text-[11px] font-mono font-bold tracking-widest text-stone-500 uppercase mb-2">Capabilities</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
          Polyglot Technology Matrix
        </h2>
        <p class="text-stone-600 text-sm leading-relaxed">
          Technologies actively deployed across the showcased repositories.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-xl bg-white border border-[#d6d3c9] shadow-xs">
          <h3 class="font-mono text-xs uppercase tracking-wider text-stone-900 font-bold mb-4">Languages & Runtimes</h3>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">TypeScript</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">C# (.NET 10)</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Python 3</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Lua (CSP SDK)</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">JavaScript</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">SQL / PostGIS</span>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-white border border-[#d6d3c9] shadow-xs">
          <h3 class="font-mono text-xs uppercase tracking-wider text-[#d9481b] font-bold mb-4">Frontend & Edge AI</h3>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Angular (18-22)</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">ONNX Runtime</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">WebAssembly</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Web Workers</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Signals & NgRx</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Tailwind CSS</span>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-white border border-[#d6d3c9] shadow-xs">
          <h3 class="font-mono text-xs uppercase tracking-wider text-blue-700 font-bold mb-4">Backend & Distributed</h3>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">ASP.NET Core</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Express / Node</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">TSyringe IoC</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">PostGIS</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Socket.io</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">MongoDB</span>
          </div>
        </div>

        <div class="p-6 rounded-xl bg-white border border-[#d6d3c9] shadow-xs">
          <h3 class="font-mono text-xs uppercase tracking-wider text-stone-900 font-bold mb-4">Native & Tooling</h3>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">WPF / Mica</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Windows DPAPI</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Chrome MV3</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">OHTTP Relays</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">TypeScript AST</span>
            <span class="px-2.5 py-1 rounded bg-[#eeece6] text-stone-800">Mermaid.js</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
