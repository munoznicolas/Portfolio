---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { siteConfig } from '../config/site.config';
import { featuredProjects, crossPlatformProjects } from '../config/projects.config';
---

<Layout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-24 sm:py-32 border-b border-[#d6d3c9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-6xl font-extrabold text-stone-900 tracking-tight leading-[1.1] mb-8">
          {siteConfig.headline}
        </h1>

        <p class="text-lg sm:text-xl text-stone-600 leading-relaxed max-w-2xl font-normal">
          {siteConfig.bio}
        </p>
      </div>
    </div>
  </section>

  <!-- Pillar I: Featured Projects -->
  <section id="architecture" class="py-20 sm:py-28 border-b border-[#d6d3c9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-2xl mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
          Featured Projects
        </h2>
      </div>

      <!-- Featured Projects Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredProjects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Pillar II: Technical Explorations -->
  <section id="cross-platform" class="py-20 sm:py-28 border-b border-[#d6d3c9] bg-[#eeece6]/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-2xl mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
          Technical Explorations
        </h2>
      </div>

      <!-- Technical Explorations Projects Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {crossPlatformProjects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Enlarged Image Modal Lightbox -->
  <ImageLightbox />
</Layout>
